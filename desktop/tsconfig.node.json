{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node", "electron-vite/node"],
    "noEmit": true
  },
  "include": ["electron/**/*.ts", "shared/**/*.ts", "electron.vite.config.ts", "../src/core/**/*.ts", "../src/worker/**/*.ts", "../src/server/redact.ts"]
}
